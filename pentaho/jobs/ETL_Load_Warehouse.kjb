><add_time>N</add_time><loglevel>Basic</loglevel><cluster>N</cluster><slave_server_name></slave_server_name><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote><create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work><run_configuration>Pentaho local</run_configuration><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>810</xloc><yloc>350</yloc></entry><entry><name>Load FactInventoryDemand</name><description></description><type>TRANS</type><specification_method>filename</specification_method><trans_object_id></trans_object_id><filename>${Internal.Entry.Current.Directory}/../transformations/Load FactInventoryDemand.ktr</filename><transname></transname><arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile></logfile><logext></logext><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><cluster>N</cluster><slave_server_name></slave_server_name><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote><create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work><run_configuration>Pentaho local</run_configuration><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>960</xloc><yloc>350</yloc></entry><entry><name>Log facts loaded</name><description></description><type>SQL</type><sql>INSERT INTO etl_run_log (run_id, job_name, step_name, status, message) VALUES ((SELECT run_id FROM etl_run_log WHERE step_name = 'Job started' ORDER BY log_id DESC LIMIT 1), 'ETL_Load_Warehouse', 'Facts loaded', 'SUCCESS', '7 fact tables loaded')</sql><useVariableSubstitution>F</useVariableSubstitution><sqlfromfile>F</sqlfromfile><sqlfilename></sqlfilename><sendOneStatement>F</sendOneStatement><connection>UC15 Warehouse</connection><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>1110</xloc><yloc>350</yloc></entry><entry><name>Log row counts</name><description></description><type>SQL</type><sql>INSERT INTO etl_run_log (run_id, job_name, step_name, status, message) SELECT (SELECT run_id FROM etl_run_log WHERE step_name = 'Job started' ORDER BY log_id DESC LIMIT 1), 'ETL_Load_Warehouse', 'Rows loaded: ' || t.tbl, 'SUCCESS', t.cnt::text FROM (SELECT 'dimdate' AS tbl, COUNT(*) AS cnt FROM dimdate UNION ALL SELECT 'dimmonth' AS tbl, COUNT(*) AS cnt FROM dimmonth UNION ALL SELECT 'dimsupplier' AS tbl, COUNT(*) AS cnt FROM dimsupplier UNION ALL SELECT 'dimwarehouseitem' AS tbl, COUNT(*) AS cnt FROM dimwarehouseitem UNION ALL SELECT 'dimiteminventory' AS tbl, COUNT(*) AS cnt FROM dimiteminventory UNION ALL SELECT 'dimcustomermaster' AS tbl, COUNT(*) AS cnt FROM dimcustomermaster UNION ALL SELECT 'dimasset' AS tbl, COUNT(*) AS cnt FROM dimasset UNION ALL SELECT 'dimemployee' AS tbl, COUNT(*) AS cnt FROM dimemployee UNION ALL SELECT 'factsales' AS tbl, COUNT(*) AS cnt FROM factsales UNION ALL SELECT 'factfinance' AS tbl, COUNT(*) AS cnt FROM factfinance UNION ALL SELECT 'factmanufacturing' AS tbl, COUNT(*) AS cnt FROM factmanufacturing UNION ALL SELECT 'factaccountsreceivable' AS tbl, COUNT(*) AS cnt FROM factaccountsreceivable UNION ALL SELECT 'factprocurement' AS tbl, COUNT(*) AS cnt FROM factprocurement UNION ALL SELECT 'factinventorydemand' AS tbl, COUNT(*) AS cnt FROM factinventorydemand UNION ALL SELECT 'factwarehousesnapshot' AS tbl, COUNT(*) AS cnt FROM factwarehousesnapshot) t</sql><useVariableSubstitution>F</useVariableSubstitution><sqlfromfile>F</sqlfromfile><sqlfilename></sqlfilename><sendOneStatement>F</sendOneStatement><connection>UC15 Warehouse</connection><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>60</xloc><yloc>490</yloc></entry><entry><name>Reconciliation check</name><description></description><type>EVAL_TABLE_CONTENT</type><connection>UC15 Warehouse</connection><schemaname></schemaname><tablename></tablename><success_condition>rows_count_equal</success_condition><limit>0</limit><is_custom_sql>Y</is_custom_sql><is_usevars>N</is_usevars><custom_sql>SELECT * FROM (
WITH expected (table_name, exp_rows, exp_total) AS (VALUES
 ('dimdate', 6209, 0.00), ('dimmonth', 12, 0.00), ('dimsupplier', 10, 0.00), ('dimwarehouseitem', 3204, 0.00),
 ('dimiteminventory', 1000, 57358.00), ('dimcustomermaster', 1500, 777900627.40), ('dimasset', 1245, 1354770.44), ('dimemployee', 35, 1520600.00),
 ('factsales', 1000, 456000.00), ('factfinance', 1000, 2535701.00), ('factmanufacturing', 1000, 3026.48),
 ('factaccountsreceivable', 45839, 816262430.00), ('factprocurement', 1300, 982390348.71),
 ('factinventorydemand', 12000, 16961896.00), ('factwarehousesnapshot', 3204, 844227.00)),
actual (table_name, act_rows, act_total) AS (
 SELECT 'dimdate', COUNT(*), 0::numeric FROM dimdate
 UNION ALL SELECT 'dimmonth', COUNT(*), 0::numeric FROM dimmonth
 UNION ALL SELECT 'dimsupplier', COUNT(*), 0::numeric FROM dimsupplier
 UNION ALL SELECT 'dimwarehouseitem', COUNT(*), 0::numeric FROM dimwarehouseitem
 UNION ALL SELECT 'dimiteminventory', COUNT(*), ROUND(SUM(price_per_unit)::numeric, 2) FROM dimiteminventory
 UNION ALL SELECT 'dimcustomermaster', COUNT(*), ROUND(SUM(credit_limit)::numeric, 2) FROM dimcustomermaster
 UNION ALL SELECT 'dimasset', COUNT(*), ROUND(SUM(maintenance_cost_last_year)::numeric, 2) FROM dimasset
 UNION ALL SELECT 'dimemployee', COUNT(*), ROUND(SUM(salary)::numeric, 2) FROM dimemployee
 UNION ALL SELECT 'factsales', COUNT(*), ROUND(SUM(total_amount)::numeric, 2) FROM factsales
 UNION ALL SELECT 'factfinance', COUNT(*), ROUND(SUM(transaction_amount)::numeric, 2) FROM factfinance
 UNION ALL SELECT 'factmanufacturing', COUNT(*), ROUND(SUM(material_used)::numeric, 2) FROM factmanufacturing
 UNION ALL SELECT 'factaccountsreceivable', COUNT(*), ROUND(SUM(amount)::numeric, 2) FROM factaccountsreceivable
 UNION ALL SELECT 'factprocurement', COUNT(*), ROUND(SUM(total_cost)::numeric, 2) FROM factprocurement
 UNION ALL SELECT 'factinventorydemand', COUNT(*), ROUND(SUM(units_demanded)::numeric, 2) FROM factinventorydemand
 UNION ALL SELECT 'factwarehousesnapshot', COUNT(*), ROUND(SUM(stock_level)::numeric, 2) FROM factwarehousesnapshot)
SELECT e.table_name, e.exp_rows, a.act_rows, e.exp_total, a.act_total,
       CASE WHEN e.exp_rows = a.act_rows AND ABS(e.exp_total - COALESCE(a.act_total, 0)) &lt; 0.05 THEN 'PASS' ELSE 'FAIL' END AS status
FROM expected e JOIN actual a ON a.table_name = e.table_name) r
WHERE r.status = 'FAIL'</custom_sql><add_rows_result>N</add_rows_result><clear_result_rows>Y</clear_result_rows><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>210</xloc><yloc>490</yloc></entry><entry><name>Log reconciliation passed</name><description></description><type>SQL</type><sql>INSERT INTO etl_run_log (run_id, job_name, step_name, status, message) VALUES ((SELECT run_id FROM etl_run_log WHERE step_name = 'Job started' ORDER BY log_id DESC LIMIT 1), 'ETL_Load_Warehouse', 'Reconciliation', 'SUCCESS', '15 of 15 tables match the control totals')</sql><useVariableSubstitution>F</useVariableSubstitution><sqlfromfile>F</sqlfromfile><sqlfilename></sqlfilename><sendOneStatement>F</sendOneStatement><connection>UC15 Warehouse</connection><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>380</xloc><yloc>490</yloc></entry><entry><name>Log job finished</name><description></description><type>SQL</type><sql>INSERT INTO etl_run_log (run_id, job_name, step_name, status, message) VALUES ((SELECT run_id FROM etl_run_log WHERE step_name = 'Job started' ORDER BY log_id DESC LIMIT 1), 'ETL_Load_Warehouse', 'Job finished', 'SUCCESS', 'Warehouse loaded and reconciled')</sql><useVariableSubstitution>F</useVariableSubstitution><sqlfromfile>F</sqlfromfile><sqlfilename></sqlfilename><sendOneStatement>F</sendOneStatement><connection>UC15 Warehouse</connection><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>560</xloc><yloc>490</yloc></entry><entry><name>Success</name><description></description><type>SUCCESS</type><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>720</xloc><yloc>490</yloc></entry><entry><name>Log reconciliation failed</name><description></description><type>SQL</type><sql>INSERT INTO etl_run_log (run_id, job_name, step_name, status, message) VALUES ((SELECT run_id FROM etl_run_log WHERE step_name = 'Job started' ORDER BY log_id DESC LIMIT 1), 'ETL_Load_Warehouse', 'Reconciliation', 'FAILED', 'At least one table does not match the control totals')</sql><useVariab